# Telegram
BOT_TOKEN=123456:ABC-your-token-from-BotFather

# Telegram user id that gets admin rights on first start.
# Find yours by sending /start to the bot — it replies with your id.
INITIAL_ADMIN_ID=0

# KPI schedule
KPI_GROUP_ID=3695
KPI_API_BASE=https://api.campus.kpi.ua
# 7 = autumn (Sep-Jan), 8 = spring (Feb-Jun). Leave empty to derive from the month.
CURRENT_SEMESTER=

# Database (inside docker compose the host is `db`)
POSTGRES_USER=unik
POSTGRES_PASSWORD=change-me
POSTGRES_DB=unik_scheduler
DATABASE_URL=postgresql+asyncpg://unik:change-me@db:5432/unik_scheduler

# Behaviour
TZ=Europe/Kyiv
REMINDER_LEAD_MINUTES=10
DIGEST_TIME=07:30
SYNC_TIME=05:00
LOG_LEVEL=INFO
